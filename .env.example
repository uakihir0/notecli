# note.com session cookie. Include the HttpOnly _note_session_v5 cookie and XSRF-TOKEN.
# notecli loads this file automatically from the current directory (Node 20.12+).
# Prefer this over command-line arguments on shared machines.
# NOTE_COOKIE='_note_session_v5=...; XSRF-TOKEN=...'

# Or point to a raw Cookie header, JSON cookie export, or Netscape cookies.txt file.
# NOTE_COOKIE_FILE=/absolute/path/to/cookies.txt

# Optional: change where `notecli auth login` stores credentials.
# NOTE_CONFIG_DIR=$HOME/.config/notecli

# Optional: force JSON or text output (default: JSON when stdout is not a TTY).
# NOTE_OUTPUT=json

# Optional: API base URL override (intended for tests/mock servers).
# NOTE_API_BASE=https://note.com/api

# Optional: request timeout in milliseconds.
# NOTE_TIMEOUT_MS=30000
